  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "morphdom": "^2.7.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
